---
import Base from "@/layouts/Base.astro";
import { getLang } from "@/utils/i18n";

const lang = getLang(Astro.url.pathname);

const text = {
  en: {
    title: "Page Not Found",
    header: "404 Page Not Found",
    description:
      "The page you are looking for might have been removed, had its name changed, or is temporarily unavailable.",
    buttonText: "Back to home",
  },
  pt: {
    title: "Page introuvable",
    header: "404 Page introuvable",
    description:
      "La page que vous recherchez a peut-être été supprimée, son nom a changé ou elle est temporairement indisponible.",
    buttonText: "Retour à l'accueil",
  },
  es: {
    title: "Página no encontrada",
    header: "404 Página no encontrada",
    description:
      "Es posible que la página que busca se haya eliminado, que se haya cambiado su nombre o que no esté disponible temporalmente.",
    buttonText: "Volver al inicio",
  },
};

const content = text[lang] || text.en; // Fallback to English if translation not available
---

<Base title={content.title}>
    <section class="section-sm text-center">
        <div class="container">
            <div class="row justify-center">
                <div class="sm:col-10 md:col-8 lg:col-6">
                    <span
                        class="text-[8rem] block font-bold text-dark dark:text-darkmode-dark"
                    >
                        404
                    </span>
                    <h1 class="h2 mb-4">{content.header}</h1>
                    <div class="content">
                        <p>
                            {content.description}
                        </p>
                    </div>
                    <a href="/" class="btn btn-primary mt-8"
                        >{content.buttonText}</a
                    >
                </div>
            </div>
        </div>
    </section>
</Base>
