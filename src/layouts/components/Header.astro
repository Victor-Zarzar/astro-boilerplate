---
import type { HeaderConfigProps } from "@/config/HeaderConfig";
import { getLang, localeLabels, locales, switchLocalePath } from "@/utils/i18n";

export interface Props extends HeaderConfigProps {
  isSticky?: boolean;
  showSearch?: boolean;
  showToggleTheme?: boolean;
  showTwitter?: boolean;
  showGithub?: boolean;
  showLanguageSwitcher?: boolean;
}

const {
  isSticky = false,
  showSearch = true,
  showToggleTheme = true,
  showTwitter = false,
  showGithub = false,
  showLanguageSwitcher = false,
  logo,
  menu,
  ctaButton,
} = Astro.props;

const currentLocale = getLang(Astro.url.pathname);
---

<header
    class:list={[
        "z-40 w-full border-b border-neutral-200/80 bg-white/80 backdrop-blur-md dark:border-neutral-800/80 dark:bg-neutral-950/80",
        isSticky ? "sticky top-0" : "relative",
    ]}
>
    <div class="container-base flex h-16 items-center justify-between gap-4">
        <!-- Logo -->
        <a
            href="/"
            class="flex shrink-0 items-center gap-2"
            aria-label={logo?.alt ?? logo?.text}
        >
            {
                logo?.image ? (
                    <img
                        src={logo.image}
                        alt={logo?.alt ?? logo?.text}
                        class="h-8 w-auto"
                    />
                ) : (
                    <span class="text-lg font-bold tracking-tight text-neutral-900 dark:text-white">
                        {logo?.text}
                    </span>
                )
            }
        </a>

        <!-- Menu desktop -->
        <nav
            class="hidden items-center gap-6 lg:flex"
            aria-label="Menu principal"
        >
            {
                menu?.map((item) => (
                    <a href={item.url} class="link-base">
                        {item.label}
                    </a>
                ))
            }
        </nav>

        <!-- Actions -->
        <div class="flex items-center gap-2">
            {
                showSearch && (
                    <button
                        type="button"
                        data-search-trigger
                        aria-label="Abrir busca"
                        class="inline-flex h-9 w-9 items-center justify-center rounded-md text-neutral-600 transition-colors hover:bg-neutral-100 hover:text-neutral-900 dark:text-neutral-300 dark:hover:bg-neutral-800 dark:hover:text-white"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            class="h-5 w-5"
                        >
                            <circle cx="11" cy="11" r="7" />
                            <path stroke-linecap="round" d="m21 21-4.3-4.3" />
                        </svg>
                    </button>
                )
            }

            {
                showToggleTheme && (
                    <button
                        type="button"
                        data-theme-toggle
                        aria-label="Alternar tema"
                        class="inline-flex h-9 w-9 items-center justify-center rounded-md text-neutral-600 transition-colors hover:bg-neutral-100 hover:text-neutral-900 dark:text-neutral-300 dark:hover:bg-neutral-800 dark:hover:text-white"
                    >
                        <svg
                            data-icon="sun"
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            class="hidden h-5 w-5 dark:block"
                        >
                            <circle cx="12" cy="12" r="4" />
                            <path
                                stroke-linecap="round"
                                d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41m11.32-11.32 1.41-1.41"
                            />
                        </svg>
                        <svg
                            data-icon="moon"
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            class="block h-5 w-5 dark:hidden"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"
                            />
                        </svg>
                    </button>
                )
            }

            {
                showGithub && (
                    <a
                        href="https://github.com"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="GitHub"
                        class="inline-flex h-9 w-9 items-center justify-center rounded-md text-neutral-600 transition-colors hover:bg-neutral-100 hover:text-neutral-900 dark:text-neutral-300 dark:hover:bg-neutral-800 dark:hover:text-white"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                            class="h-5 w-5"
                        >
                            <path d="M12 .5C5.73.5.5 5.73.5 12c0 5.08 3.29 9.39 7.86 10.91.57.1.78-.25.78-.55v-2.1c-3.2.7-3.87-1.36-3.87-1.36-.53-1.34-1.29-1.7-1.29-1.7-1.06-.72.08-.71.08-.71 1.17.08 1.78 1.2 1.78 1.2 1.04 1.78 2.72 1.27 3.38.97.1-.75.4-1.27.73-1.56-2.55-.29-5.23-1.27-5.23-5.68 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.58.23 2.75.11 3.04.74.8 1.18 1.83 1.18 3.08 0 4.42-2.69 5.39-5.25 5.67.41.36.78 1.08.78 2.17v3.22c0 .3.21.66.79.55A10.52 10.52 0 0 0 23.5 12c0-6.27-5.23-11.5-11.5-11.5Z" />
                        </svg>
                    </a>
                )
            }

            {
                showTwitter && (
                    <a
                        href="https://twitter.com"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Twitter / X"
                        class="inline-flex h-9 w-9 items-center justify-center rounded-md text-neutral-600 transition-colors hover:bg-neutral-100 hover:text-neutral-900 dark:text-neutral-300 dark:hover:bg-neutral-800 dark:hover:text-white"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                            class="h-5 w-5"
                        >
                            <path d="M18.24 2H21l-6.55 7.49L22.2 22h-6.94l-5.43-7.1L3.6 22H.83l7.01-8.01L1.8 2h7.1l4.9 6.49L18.24 2Zm-1.21 18.17h1.53L7.05 3.75H5.4l11.63 16.42Z" />
                        </svg>
                    </a>
                )
            }

            {
                showLanguageSwitcher && (
                    <div class="relative" data-lang-switcher>
                        <button
                            type="button"
                            data-lang-trigger
                            aria-haspopup="listbox"
                            aria-expanded="false"
                            class="inline-flex h-9 items-center gap-1 rounded-md px-2 text-sm font-medium text-neutral-600 transition-colors hover:bg-neutral-100 hover:text-neutral-900 dark:text-neutral-300 dark:hover:bg-neutral-800 dark:hover:text-white"
                        >
                            {localeLabels[currentLocale]}
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                class="h-3.5 w-3.5"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="m6 9 6 6 6-6"
                                />
                            </svg>
                        </button>
                        <ul
                            data-lang-menu
                            role="listbox"
                            class="absolute right-0 mt-2 hidden w-28 rounded-md border border-neutral-200 bg-white py-1 shadow-lg dark:border-neutral-800 dark:bg-neutral-900"
                        >
                            {locales.map((locale) => (
                                <li>
                                    <a
                                        href={switchLocalePath(
                                            Astro.url.pathname,
                                            locale,
                                        )}
                                        class="block px-3 py-1.5 text-sm text-neutral-700 hover:bg-neutral-100 dark:text-neutral-200 dark:hover:bg-neutral-800"
                                    >
                                        {localeLabels[locale]}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </div>
                )
            }

            {
                ctaButton && (
                    <a
                        href={ctaButton.url}
                        class="ml-2 hidden rounded-md bg-primary px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-primary/90 lg:inline-flex"
                    >
                        {ctaButton.label}
                    </a>
                )
            }

            <!-- Button mobile menu -->
            <button
                type="button"
                data-mobile-menu-trigger
                aria-label="Abrir menu"
                aria-expanded="false"
                class="inline-flex h-9 w-9 items-center justify-center rounded-md text-neutral-600 hover:bg-neutral-100 dark:text-neutral-300 dark:hover:bg-neutral-800 lg:hidden"
            >
                <svg
                    data-icon="menu-open"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    class="h-5 w-5"
                >
                    <path stroke-linecap="round" d="M3 6h18M3 12h18M3 18h18"
                    ></path>
                </svg>
            </button>
        </div>
    </div>

    <!-- Menu mobile -->
    <nav
        data-mobile-menu
        class="hidden border-t border-neutral-200 px-4 py-3 dark:border-neutral-800 lg:hidden"
        aria-label="Menu mobile"
    >
        {
            menu?.map((item) => (
                <a
                    href={item.url}
                    class="block rounded-md px-2 py-2 text-sm font-medium text-neutral-700 hover:bg-neutral-100 dark:text-neutral-200 dark:hover:bg-neutral-800"
                >
                    {item.label}
                </a>
            ))
        }
        {
            ctaButton && (
                <a
                    href={ctaButton.url}
                    class="mt-2 block rounded-md bg-primary px-4 py-2 text-center text-sm font-semibold text-white hover:bg-primary/90"
                >
                    {ctaButton.label}
                </a>
            )
        }
    </nav>
</header>

<script>
    // Toggle mobile menu
    const mobileTrigger = document.querySelector<HTMLButtonElement>(
        "[data-mobile-menu-trigger]",
    );
    const mobileMenu =
        document.querySelector<HTMLElement>("[data-mobile-menu]");

    mobileTrigger?.addEventListener("click", () => {
        const isOpen = mobileMenu?.classList.toggle("hidden") === false;
        mobileTrigger.setAttribute("aria-expanded", String(isOpen));
    });

    // Toggle theme (dark/light) with persistence
    const themeToggle = document.querySelector<HTMLButtonElement>(
        "[data-theme-toggle]",
    );
    themeToggle?.addEventListener("click", () => {
        const isDark = document.documentElement.classList.toggle("dark");
        localStorage.setItem("theme", isDark ? "dark" : "light");
    });

    // Open search modal via custom event (consumed by SearchModal React)
    const searchTrigger = document.querySelector<HTMLButtonElement>(
        "[data-search-trigger]",
    );
    searchTrigger?.addEventListener("click", () => {
        window.dispatchEvent(new CustomEvent("open-search-modal"));
    });

    // Open language switcher dropdown
    const langSwitcher = document.querySelector<HTMLElement>(
        "[data-lang-switcher]",
    );
    const langTrigger = langSwitcher?.querySelector<HTMLButtonElement>(
        "[data-lang-trigger]",
    );
    const langMenu =
        langSwitcher?.querySelector<HTMLElement>("[data-lang-menu]");

    langTrigger?.addEventListener("click", (event) => {
        event.stopPropagation();
        const isOpen = langMenu?.classList.toggle("hidden") === false;
        langTrigger.setAttribute("aria-expanded", String(isOpen));
    });

    document.addEventListener("click", () => {
        langMenu?.classList.add("hidden");
        langTrigger?.setAttribute("aria-expanded", "false");
    });
</script>
