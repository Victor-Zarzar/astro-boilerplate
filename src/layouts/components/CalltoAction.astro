---
import { getEntry } from "astro:content";
import { getLang } from "@/utils/i18n";

const cta = await getEntry("sections", "cta");
const lang = getLang(Astro.url.pathname);

const link = cta.data.button.link;
const adjustLink = lang === "en" ? link : `${lang}${link}`;
---

{
    cta.data.enable && (
        <div class="relative overflow-hidden rounded-3xl bg-dark px-6 py-16 text-center dark:bg-darkmode-dark/5 sm:px-16">
            <h2 class="text-2xl md:text-3xl lg:text-4xl lg:tracking-tight text-darkmode-dark dark:text-dark">
                {cta.data[lang].title}
            </h2>
            <p class="mx-auto mt-4 max-w-2xl text-lg text-darkmode-dark/70 dark:text-dark/70">
                {cta.data[lang].description}
            </p>

            <div class="mt-10 flex justify-center">
                <a
                    href={adjustLink}
                    class="relative flex h-12 items-center justify-center px-8 before:bg-primary before:absolute before:inset-0 before:rounded-full before:transition before:duration-300 hover:before:scale-105 active:duration-75 active:before:scale-95 sm:w-max"
                >
                    <span class="relative text-darkmode-dark dark:text-darkmode-dark">
                        {cta.data[lang].label}
                    </span>
                </a>
            </div>
        </div>
    )
}
